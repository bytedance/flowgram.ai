  {
    "type": "control.join",
    "title": "Parallel join",
    "group": "Control flow",
    "description": "Wait for all active branches, the first success, or a success quorum",
    "defaults": {
      "forkId": "",
      "mappings": {},
      "policy": "all",
      "errorMode": "fail",
      "quorum": 1
    },
    "fields": [
      {
        "key": "forkId",
        "label": "Source fork",
        "editor": "node-select",
        "required": true
      },
      {
        "key": "policy",
        "label": "Completion policy",
        "editor": "select",
        "choices": [
          ["all", "All completed"],
          ["first-success", "First success"],
          ["quorum", "Success quorum"]
        ]
      },
      {
        "key": "quorum",
        "label": "Required successes",
        "editor": "number",
        "defaultValue": 1,
        "min": 1,
        "max": 32,
        "visible": {
          "field": "policy",
          "values": ["quorum"]
        }
      },
      {
        "key": "errorMode",
        "label": "On branch failure",
        "editor": "select",
        "choices": [
          ["fail", "Stop scope"],
          ["collect", "Collect errors"]
        ]
      },
      {
        "key": "mappings",
        "label": "Branch results",
        "editor": "branch-mappings"
      }
    ],
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "object"
        },
        "completedBranchIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successfulBranchIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sideEffects": "control",
    "version": 1,
    "ports": {
      "strategy": "fork-branches",
      "maxConnectionsPerOutput": 1,
      "coordinates": "static",
      "identity": "stable-id"
    },
    "execution": {
      "scope": "structured",
      "maxBranches": 32,
      "maxConcurrentLeafNodes": 32,
      "maxNodeExecutionsPerRun": 10000
    }
  },
