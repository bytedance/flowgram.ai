  {
    "type": "control.repeat",
    "title": "Repeat until",
    "group": "Control flow",
    "description": "Repeat a subgraph with state until an exit condition is met",
    "defaults": {
      "initialState": {
        "type": "constant",
        "content": {}
      },
      "stateSchema": {
        "type": "object",
        "properties": {}
      },
      "stateUpdates": {},
      "predicate": {
        "combinator": "and",
        "rules": [
          {
            "left": {
              "type": "constant",
              "content": true
            },
            "operator": "eq",
            "right": {
              "type": "constant",
              "content": true
            }
          }
        ]
      },
      "check": "before",
      "maxIterations": 20
    },
    "fields": [
      {
        "key": "stateSchema",
        "label": "State schema",
        "editor": "schema"
      },
      {
        "key": "initialState",
        "label": "Initial state",
        "editor": "value",
        "type": "object",
        "required": true
      },
      {
        "key": "check",
        "label": "Check exit condition",
        "editor": "select",
        "choices": [
          ["before", "Before each iteration"],
          ["after", "After each iteration"]
        ]
      },
      {
        "key": "predicate",
        "label": "Exit condition",
        "editor": "predicate",
        "operators": [
          ["eq", "Equals"],
          ["neq", "Does not equal"],
          ["gt", "Greater than"],
          ["gte", "Greater than or equal"],
          ["lt", "Less than"],
          ["lte", "Less than or equal"],
          ["contains", "Contains"],
          ["starts", "Starts with"],
          ["ends", "Ends with"],
          ["in", "In list"],
          ["exists", "Exists"],
          ["missing", "Does not exist"],
          ["null", "Is null"],
          ["empty", "Is empty"]
        ]
      },
      {
        "key": "maxIterations",
        "label": "Maximum iterations",
        "editor": "number",
        "defaultValue": 20,
        "min": 1,
        "max": 1000
      },
      {
        "key": "stateUpdates",
        "label": "State after iteration",
        "editor": "mapping",
        "scope": "children"
      }
    ],
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object"
        },
        "iterations": {
          "type": "integer"
        },
        "exitReason": {
          "type": "string"
        }
      }
    },
    "sideEffects": "control",
    "version": 1,
    "ports": {
      "strategy": "task",
      "maxConnectionsPerOutput": 1,
      "coordinates": "static",
      "identity": "stable-id"
    },
    "execution": {
      "scope": "structured",
      "maxBranches": 32,
      "maxConcurrentLeafNodes": 32,
      "maxNodeExecutionsPerRun": 10000
    }
  },
  {
    "type": "control.break",
