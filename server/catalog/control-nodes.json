  {
    "type": "loop",
    "title": "For each",
    "group": "Control flow",
    "description": "Run a subgraph per item, serially or with bounded concurrency, preserving input order",
    "defaults": {
      "loopFor": {
        "type": "ref",
        "content": ["start", "items"]
      },
      "loopOutputs": {},
      "mode": "serial",
      "concurrency": 4,
      "errorMode": "fail"
    },
    "fields": [
      {
        "key": "loopFor",
        "label": "For each",
        "editor": "value",
        "type": "array",
        "required": true
      },
      {
        "key": "mode",
        "label": "Execution mode",
        "editor": "select",
        "choices": [
          ["serial", "Serial"],
          ["parallel", "Parallel"]
        ]
      },
      {
        "key": "concurrency",
        "label": "Maximum concurrency",
        "editor": "number",
        "defaultValue": 4,
        "min": 1,
        "max": 32,
        "visible": {
          "field": "mode",
          "values": ["parallel"]
        }
      },
      {
        "key": "errorMode",
        "label": "On item failure",
        "editor": "select",
        "choices": [
          ["fail", "Stop loop"],
          ["collect", "Keep errors and positions"],
          ["skip", "Remove failed items"]
        ]
      },
      {
        "key": "loopOutputs",
        "label": "Collect results",
        "editor": "mapping",
        "scope": "children",
        "hint": "Select iteration outputs. Parallel execution preserves input order; empty lists return empty results."
      }
    ],
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array"
