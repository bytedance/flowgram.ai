[
  {
    "type": "control.switch",
    "title": "Switch",
    "group": "Control flow",
    "description": "Select the first matching branch, or execute all matching branches",
    "defaults": {
      "mode": "first",
      "branches": [
        {
          "id": "case_a",
          "label": "Branch A",
          "predicate": {
            "combinator": "and",
            "rules": [
              {
                "left": {
                  "type": "constant",
                  "content": true
                },
                "operator": "eq",
                "right": {
                  "type": "constant",
                  "content": true
                }
              }
            ]
          }
        },
        {
          "id": "case_b",
          "label": "Branch B",
          "predicate": {
            "combinator": "and",
            "rules": [
              {
                "left": {
                  "type": "constant",
                  "content": true
                },
                "operator": "eq",
                "right": {
                  "type": "constant",
                  "content": true
                }
              }
            ]
          }
        }
      ],
      "joinId": ""
    },
    "fields": [
      {
        "key": "mode",
        "label": "Match mode",
        "editor": "select",
        "choices": [
          ["first", "First match"],
          ["all", "All matches"]
        ]
      },
      {
        "key": "branches",
        "label": "Branches and outputs",
        "editor": "branches",
        "operators": [
          ["eq", "Equals"],
          ["neq", "Does not equal"],
          ["gt", "Greater than"],
          ["gte", "Greater than or equal"],
          ["lt", "Less than"],
          ["lte", "Less than or equal"],
          ["contains", "Contains"],
          ["starts", "Starts with"],
          ["ends", "Ends with"],
          ["in", "In list"],
          ["exists", "Exists"],
          ["missing", "Does not exist"],
          ["null", "Is null"],
          ["empty", "Is empty"]
        ]
      },
      {
        "key": "joinId",
        "label": "Matching join",
        "editor": "node-select",
        "required": true,
        "hint": "Select a join in the same canvas scope."
      }
    ],
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "matchedBranchIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sideEffects": "control",
    "version": 1,
    "ports": {
      "strategy": "branches",
      "maxConnectionsPerOutput": 1,
      "coordinates": "static",
      "identity": "stable-id"
    },
    "execution": {
      "scope": "structured",
      "maxBranches": 32,
      "maxConcurrentLeafNodes": 32,
      "maxNodeExecutionsPerRun": 10000
    }
  },
  {
    "type": "control.parallel",
    "title": "Parallel fork",
    "group": "Control flow",
    "description": "Start independent branches and collect results at the matching join",
    "defaults": {
      "branches": [
        {
          "id": "branch_a",
          "label": "Branch A"
        },
        {
          "id": "branch_b",
          "label": "Branch B"
        }
      ],
      "joinId": "",
      "concurrency": 4
    },
    "fields": [
      {
        "key": "branches",
        "label": "Branches and outputs",
        "editor": "branches",
        "operators": [
          ["eq", "Equals"],
          ["neq", "Does not equal"],
          ["gt", "Greater than"],
          ["gte", "Greater than or equal"],
          ["lt", "Less than"],
          ["lte", "Less than or equal"],
          ["contains", "Contains"],
          ["starts", "Starts with"],
          ["ends", "Ends with"],
          ["in", "In list"],
          ["exists", "Exists"],
          ["missing", "Does not exist"],
