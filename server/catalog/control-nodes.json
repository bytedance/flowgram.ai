      {
        "key": "concurrency",
        "label": "Maximum concurrent branches",
        "editor": "number",
        "defaultValue": 4,
        "min": 1,
        "max": 32
      }
    ],
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "sideEffects": "control",
    "version": 1,
    "ports": {
      "strategy": "branches",
      "maxConnectionsPerOutput": 1,
