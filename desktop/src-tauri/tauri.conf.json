{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowGram",
  "version": "0.1.0",
  "identifier": "ai.flowgram.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-native.mjs dev",
    "beforeBuildCommand": "node scripts/prepare-native.mjs build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "FlowGram",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "backgroundColor": "#fafafa"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/flowgram-server", "binaries/flowgram-service"],
    "shortDescription": "Workflow desktop workbench"
  }
}
