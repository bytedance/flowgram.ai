    },
    "readOnly": true,
    "initial": false,
    "uiIntent": "none",
    "group": "authoring"
  },
  {
    "name": "revert_workflow_change",
    "description": "Apply the inverse of one committed change. Preserves unrelated later edits and rejects overlap; does not reverse external side effects.",
    "parameters": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "mutationId": {
          "type": "string"
        },
        "changeId": {
          "type": "string"
        }
      },
      "required": ["workflowId", "expectedRevision", "mutationId", "changeId"],
      "additionalProperties": false
    },
    "readOnly": false,
    "initial": false,
    "uiIntent": "workflow",
    "group": "authoring"
  },
  {
    "name": "layout_workflow",
