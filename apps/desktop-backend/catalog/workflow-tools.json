        }
      },
      "required": ["workflowId", "expectedRevision", "mutationId"],
      "additionalProperties": false
    },
    "readOnly": false,
    "initial": false,
    "uiIntent": "workflow",
    "group": "authoring"
  },
  {
    "name": "validate_workflow",
    "description": "Validate a pinned definition. Returns structured diagnostics and distinguishes full graph validation from a filtered local result.",
    "parameters": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string"
        },
        "source": {
          "oneOf": [
            {
              "const": "draft"
