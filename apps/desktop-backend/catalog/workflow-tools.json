  {
    "name": "edit_workflow",
    "description": "Atomically apply precise graph operations with revision CAS and idempotent mutationId. set/unset paths are JSON Pointers relative to node.data; omitted fields are preserved. Never resend a complete graph. Defaults and loop/fork scaffolds are backend-owned. Dry runs do not save. Query get_workflow_change after uncertain delivery.",
    "parameters": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "mutationId": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "rename_workflow"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["op", "name"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add_node"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "nodeType": {
                    "type": "string"
                  },
                  "scopeId": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "boundaryIds": {
                    "type": "object",
                    "properties": {
                      "entry": {
                        "type": "string"
                      },
                      "exit": {
                        "type": "string"
                      }
                    },
                    "required": ["entry", "exit"],
                    "additionalProperties": false
                  },
                  "joinId": {
                    "type": "string"
                  }
                },
                "required": ["op", "nodeType", "scopeId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "update_node"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "set": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "unset": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["op", "nodeId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "replace_text"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "edits": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "oldText": {
                          "type": "string"
                        },
                        "newText": {
                          "type": "string"
                        },
                        "expectedMatches": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": ["oldText", "newText"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["op", "nodeId", "path", "edits"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "edit_collection"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "enum": ["insert", "update", "remove", "move"]
                        },
                        "key": {
                          "type": "object",
                          "additionalProperties": true,
                          "minProperties": 1
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "expectedItemHash": {
                          "type": "string"
                        },
                        "set": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "value": {},
                        "toIndex": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "unset": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": ["action"],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "action": {
                                "const": "insert"
                              }
                            }
                          },
                          "then": {
                            "required": ["value"]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "action": {
                                "const": "update"
                              }
                            }
                          },
                          "then": {
                            "anyOf": [
                              {
                                "required": ["set"]
                              },
                              {
                                "required": ["unset"]
                              }
                            ]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "action": {
                                "const": "move"
                              }
                            }
                          },
                          "then": {
                            "required": ["toIndex"]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "action": {
                                "enum": ["update", "remove", "move"]
                              }
                            }
                          },
                          "then": {
                            "oneOf": [
                              {
                                "required": ["key"],
                                "not": {
                                  "required": ["index"]
                                }
                              },
                              {
                                "required": ["index", "expectedItemHash"],
                                "not": {
                                  "required": ["key"]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "required": ["op", "nodeId", "path", "changes"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove_node"
                  },
                  "nodeId": {
                    "type": "string"
                  }
                },
                "required": ["op", "nodeId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "replace_node_type"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "nodeType": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "outputMapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "sourcePortMapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "targetPortMapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": ["op", "nodeId", "nodeType"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "connect"
                  },
                  "scopeId": {
                    "type": "string"
                  },
                  "edge": {
                    "$ref": "#/$defs/edge"
                  }
                },
                "required": ["op", "scopeId", "edge"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "disconnect"
                  },
                  "scopeId": {
                    "type": "string"
                  },
                  "edge": {
                    "$ref": "#/$defs/edge"
                  }
                },
                "required": ["op", "scopeId", "edge"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "reconnect"
                  },
                  "scopeId": {
                    "type": "string"
                  },
                  "from": {
                    "$ref": "#/$defs/edge"
                  },
                  "to": {
                    "$ref": "#/$defs/edge"
                  }
                },
                "required": ["op", "scopeId", "from", "to"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "insert_node"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "nodeType": {
                    "type": "string"
                  },
                  "scopeId": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "boundaryIds": {
                    "type": "object",
                    "properties": {
                      "entry": {
                        "type": "string"
                      },
                      "exit": {
                        "type": "string"
                      }
                    },
                    "required": ["entry", "exit"],
                    "additionalProperties": false
                  },
                  "joinId": {
                    "type": "string"
                  },
                  "edge": {
                    "$ref": "#/$defs/edge"
                  }
                },
                "required": ["op", "nodeType", "scopeId", "edge"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add_branch"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "branchId": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": ["op", "nodeId", "branchId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "update_branch"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "branchId": {
                    "type": "string"
                  },
                  "set": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": ["op", "nodeId", "branchId", "set"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove_branch"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "branchId": {
                    "type": "string"
                  }
                },
                "required": ["op", "nodeId", "branchId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "move_branch"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "branchId": {
                    "type": "string"
                  },
                  "before": {
                    "type": "string"
                  },
                  "after": {
                    "type": "string"
                  }
                },
                "required": ["op", "nodeId", "branchId"],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": ["before"],
                    "not": {
                      "required": ["after"]
                    }
                  },
                  {
                    "required": ["after"],
                    "not": {
                      "required": ["before"]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "duplicate_subgraph"
                  },
                  "nodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetScopeId": {
                    "type": "string"
                  },
                  "idMapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": ["op", "nodeIds", "targetScopeId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "move_subgraph"
                  },
                  "nodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetScopeId": {
                    "type": "string"
                  },
                  "idMapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": ["op", "nodeIds", "targetScopeId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "move_nodes"
                  },
                  "positions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nodeId": {
                          "type": "string"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": ["nodeId", "x", "y"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["op", "positions"],
                "additionalProperties": false
              }
            ]
          }
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "required": [
        "workflowId",
        "expectedRevision",
        "mutationId",
        "operations"
      ],
      "additionalProperties": false,
      "$defs": {
        "edge": {
          "type": "object",
          "properties": {
            "sourceNodeID": {
              "type": "string"
            },
            "targetNodeID": {
              "type": "string"
            },
            "sourcePortID": {
              "type": "string"
            },
            "targetPortID": {
              "type": "string"
            }
          },
          "required": ["sourceNodeID", "targetNodeID"],
          "additionalProperties": false
        }
      }
    },
    "readOnly": false,
    "initial": true,
    "uiIntent": "workflow",
    "group": "authoring"
  },
  {
    "name": "get_workflow_change",
